# Green Twin — environment configuration (example)
#
# Copy this file to `.env` (repo root) or `scripts/.env` and fill in real
# values. NEVER commit a real `.env` — it is git-ignored.
#
# The OpenRouter API key is used by the backend ONLY. It is never sent to the
# browser, never embedded in a frontend bundle, and never included in an API
# response or log line.

# ── Generative AI (OpenRouter) ───────────────────────────────────────────────
# Required for the AI assistant. Without it the app still runs and the UI
# shows an honest "AI not configured" message.
OPENROUTER_API_KEY=

# Model to use. Defaults to the free NVIDIA Nemotron endpoint.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# OpenRouter API base URL (OpenAI-compatible Chat Completions).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional attribution headers recommended by OpenRouter.
OPENROUTER_REFERER=
OPENROUTER_TITLE=Green Twin

# Optional per-phase network timeout in seconds (default 30). This is the
# connect/read/write timeout passed to the HTTP client.
OPENROUTER_TIMEOUT=30

# Optional TOTAL deadline in seconds for one AI request (default 90), covering
# every transport attempt. It bounds the worst case even when a slow endpoint
# keeps trickling bytes (which would otherwise reset the per-phase read timeout).
# It is clamped up to OPENROUTER_TIMEOUT when set lower.
OPENROUTER_DEADLINE=90
